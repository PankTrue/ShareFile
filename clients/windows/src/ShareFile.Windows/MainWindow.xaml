<Window x:Class="ShareFile.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShareFile" Width="1020" Height="720" MinWidth="760" MinHeight="560"
        ThemeMode="System" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
      <StackPanel DockPanel.Dock="Left"><TextBlock Text="ShareFile" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="Загрузить файлы или папку и поделиться ссылками" Foreground="Gray"/></StackPanel>
      <StackPanel HorizontalAlignment="Right"><TextBlock Text="{Binding Username}" HorizontalAlignment="Right"/>
        <Button Content="Открыть хранилище" Command="{Binding OpenWebCommand}" Margin="0,6,0,0"/></StackPanel>
    </DockPanel>
    <TabControl x:Name="ClientTabs" Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="Файлы">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel><Button Content="Выбрать файлы…" Command="{Binding ChooseFilesCommand}"/>
            <Button Content="Загрузить папку…" Command="{Binding ChooseDirectoryCommand}"/>
            <Button Content="Пауза для всех" Command="{Binding PauseAllCommand}"/></WrapPanel>
          <TextBlock Grid.Row="1" Margin="0,4,0,16" TextWrapping="Wrap"><Run Text="Папка назначения: "/><Run Text="{Binding FolderName}"/><Run Text=". Перетащите файлы или папку в окно. Для папки создаётся одна ссылка."/></TextBlock>
          <DataGrid Grid.Row="2" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" AutoGenerateColumns="False"
                    IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" EnableRowVirtualization="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Файл или папка" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="190"/>
              <DataGridTemplateColumn Header="Загрузка" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                <StackPanel Margin="8"><ProgressBar Value="{Binding Progress}" Height="5" Maximum="100"/>
                  <TextBlock Text="{Binding Bytes}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
              </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{Binding SelectedJob.Message}" Margin="0,0,0,8"/>
            <WrapPanel>
              <Button Content="Продолжить" Command="{Binding ResumeCommand}"/>
              <Button Content="Скопировать ссылку" Command="{Binding CopyLinkCommand}"/>
              <Button Content="Новая ссылка" Command="{Binding NewLinkCommand}"/>
              <Button Content="Отозвать ссылку" Command="{Binding RevokeLinkCommand}"/>
              <Button Content="Отменить / убрать" Command="{Binding RemoveCommand}"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Настройки">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20" MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Text="Подключение" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Адрес сервера (HTTPS)" Margin="0,12,0,0"/>
          <TextBox Text="{Binding ServerInput, UpdateSourceTrigger=PropertyChanged}" MinWidth="560"/>
          <WrapPanel><Button Content="Подключить через браузер" Command="{Binding ConnectCommand}"/>
            <Button Content="Отмена подключения" Command="{Binding ConnectCancelCommand}"/>
            <Button Content="Отключить компьютер" Command="{Binding DisconnectCommand}"/>
            <Button Content="Открыть подтверждение" Command="{Binding OpenPairingCommand}"/></WrapPanel>
          <TextBlock Text="Ссылки" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,8"/>
          <TextBlock Text="Срок ссылки, дней (1–365)"/>
          <TextBox Text="{Binding Days, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100" HorizontalAlignment="Left"/>
          <CheckBox Content="Без срока действия" IsChecked="{Binding Never}"/>
          <TextBlock Text="Пароль ссылки (необязательно, 12–256 байт UTF-8)"/>
          <PasswordBox x:Name="LinkPasswordBox" PasswordChanged="OnPasswordChanged" Padding="8,6" Margin="0,4,0,12"/>
          <CheckBox Content="Загружать из Проводника без открытия окна" IsChecked="{Binding SilentExplorerUploads}"/>
          <CheckBox Content="Уведомлять о загрузке и копировании ссылок" IsChecked="{Binding NotifyUploads}"/>
          <Button Content="Сохранить настройки" Command="{Binding SaveOptionsCommand}" HorizontalAlignment="Left"/>
          <TextBlock Text="Папка назначения" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,8"/>
          <WrapPanel><Button Content="Доступные папки" Command="{Binding BrowseFoldersCommand}"/>
            <Button Content="Назад" Command="{Binding FolderBackCommand}"/>
            <Button Content="Открыть папку" Command="{Binding EnterFolderCommand}"/>
            <Button Content="Выбрать папку" Command="{Binding SelectFolderCommand}"/></WrapPanel>
          <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" DisplayMemberPath="Name" Height="130"/>
          <TextBlock Text="Для загрузки и создания ссылки нужны права управляющего папкой. Закрытие окна оставляет ShareFile в трее; выход доступен в меню значка." Foreground="Gray" Margin="0,12,0,12"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="История ссылок">
        <Grid Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBox Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Поиск по имени файла или папки" ToolTip="Найти файл или папку в истории"/>
          <TextBlock Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap" Foreground="Gray" Text="История хранит до 200 ссылок. Показаны ссылки текущего аккаунта. Ссылки защищены Windows Credential Manager. Очистка очереди сохраняет историю."/>
          <DataGrid Grid.Row="2" ItemsSource="{Binding HistoryRows}" SelectedItem="{Binding SelectedHistory}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Файл или папка" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Создана" Binding="{Binding CreatedLabel}" Width="150"/>
              <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="190"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="Копировать ссылку" Command="{Binding CopyHistoryCommand}"/>
            <Button Content="Открыть ссылку" Command="{Binding OpenHistoryCommand}"/>
            <Button Content="Отозвать ссылку" Command="{Binding RevokeHistoryCommand}"/>
          </WrapPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Padding="0,16,0,0"><TextBlock Text="{Binding Notice}" AutomationProperties.LiveSetting="Polite"/></Border>
  </Grid>
</Window>
