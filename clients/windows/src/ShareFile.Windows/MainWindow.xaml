<Window x:Class="ShareFile.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShareFile" Width="1020" Height="720" MinWidth="760" MinHeight="560"
        ThemeMode="System" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
      <StackPanel DockPanel.Dock="Left"><TextBlock Text="ShareFile" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="{DynamicResource Text0}" Foreground="Gray"/></StackPanel>
      <StackPanel HorizontalAlignment="Right"><TextBlock Text="{Binding Username}" HorizontalAlignment="Right"/>
        <Button Content="{DynamicResource Text1}" Command="{Binding OpenWebCommand}" Margin="0,6,0,0"/></StackPanel>
    </DockPanel>
    <TabControl x:Name="ClientTabs" Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="{DynamicResource Text2}">
        <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <WrapPanel><Button Content="{DynamicResource Text3}" Command="{Binding ChooseFilesCommand}"/>
            <Button Content="{DynamicResource Text4}" Command="{Binding ChooseDirectoryCommand}"/>
            <Button Content="{DynamicResource Text5}" Command="{Binding UploadClipboardCommand}"/>
            <Button Content="{DynamicResource Text6}" Command="{Binding PauseAllCommand}"/></WrapPanel>
          <StackPanel Grid.Row="1" Margin="0,4,0,16">
            <TextBlock TextWrapping="Wrap"><Run Text="{DynamicResource Text7}"/><Run Text="{Binding FolderName}"/><Run Text="{DynamicResource Text8}"/></TextBlock>
            <TextBlock Text="{Binding TotalLabel}" Margin="0,12,0,5"/>
            <ProgressBar Value="{Binding TotalProgress}" Maximum="100" Height="6" AutomationProperties.Name="{DynamicResource Text9}"/>
            <TextBlock Text="{Binding TotalDetail}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0"/>
          </StackPanel>
          <DataGrid Grid.Row="2" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" AutoGenerateColumns="False"
                    IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" EnableRowVirtualization="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{DynamicResource Text10}" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="{DynamicResource Text11}" Binding="{Binding Status}" Width="190"/>
              <DataGridTemplateColumn Header="{DynamicResource Text12}" Width="260"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                <StackPanel Margin="8"><ProgressBar Value="{Binding Progress}" Height="5" Maximum="100"/>
                  <TextBlock Text="{Binding Bytes}" FontSize="11" Margin="0,4,0,0"/>
                  <TextBlock Text="{Binding TransferDetails}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
              </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{Binding SelectedJob.Message}" Margin="0,0,0,8"/>
            <WrapPanel>
              <Button Content="{DynamicResource Text13}" Command="{Binding ResumeCommand}"/>
              <Button Content="{DynamicResource Text14}" Command="{Binding CopyLinkCommand}"/>
              <Button Content="{DynamicResource Text15}" Command="{Binding NewLinkCommand}"/>
              <Button Content="{DynamicResource Text16}" Command="{Binding RevokeLinkCommand}"/>
              <Button Content="{DynamicResource Text17}" Command="{Binding RemoveCommand}"/>
            </WrapPanel>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="{DynamicResource Text18}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20" MaxWidth="720" HorizontalAlignment="Left">
          <TextBlock Text="{DynamicResource AppLanguage}" FontSize="20" FontWeight="SemiBold"/>
          <ComboBox x:Name="LanguagePicker" SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Tag" Width="220" HorizontalAlignment="Left" Margin="0,8,0,8">
            <ComboBoxItem Content="English" Tag="en"/>
            <ComboBoxItem Content="Русский" Tag="ru"/>
          </ComboBox>
          <TextBlock Text="{DynamicResource LanguageSaved}" Foreground="Gray" Margin="0,0,0,16"/>
          <TextBlock Text="{DynamicResource Text19}" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="{DynamicResource Text20}" Margin="0,12,0,0"/>
          <TextBox Text="{Binding ServerInput, UpdateSourceTrigger=PropertyChanged}" MinWidth="560"/>
          <WrapPanel><Button Content="{DynamicResource Text21}" Command="{Binding ConnectCommand}"/>
            <Button Content="{DynamicResource Text22}" Command="{Binding ConnectCancelCommand}"/>
            <Button Content="{DynamicResource Text23}" Command="{Binding DisconnectCommand}"/>
            <Button Content="{DynamicResource Text24}" Command="{Binding OpenPairingCommand}"/></WrapPanel>
          <TextBlock Text="{DynamicResource Text25}" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,8"/>
          <TextBlock Text="{DynamicResource Text26}"/>
          <TextBox Text="{Binding Days, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="100" HorizontalAlignment="Left"/>
          <CheckBox Content="{DynamicResource Text27}" IsChecked="{Binding Never}"/>
          <TextBlock Text="{DynamicResource Text28}"/>
          <PasswordBox x:Name="LinkPasswordBox" PasswordChanged="OnPasswordChanged" Padding="8,6" Margin="0,4,0,12"/>
          <CheckBox Content="{DynamicResource Text29}" IsChecked="{Binding SilentExplorerUploads}"/>
          <CheckBox Content="{DynamicResource Text30}" IsChecked="{Binding NotifyUploads}"/>
          <Button Content="{DynamicResource Text31}" Command="{Binding SaveOptionsCommand}" HorizontalAlignment="Left"/>
          <TextBlock Text="{DynamicResource Text32}" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,8"/>
          <WrapPanel><Button Content="{DynamicResource Text33}" Command="{Binding BrowseFoldersCommand}"/>
            <Button Content="{DynamicResource Text34}" Command="{Binding FolderBackCommand}"/>
            <Button Content="{DynamicResource Text35}" Command="{Binding EnterFolderCommand}"/>
            <Button Content="{DynamicResource Text36}" Command="{Binding SelectFolderCommand}"/></WrapPanel>
          <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" DisplayMemberPath="Name" Height="130"/>
          <TextBlock Text="{DynamicResource Text37}" Foreground="Gray" Margin="0,12,0,12"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource Text38}">
        <Grid Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBox Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Text39}" ToolTip="{DynamicResource Text40}"/>
          <TextBlock Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap" Foreground="Gray" Text="{DynamicResource Text41}"/>
          <DataGrid Grid.Row="2" ItemsSource="{Binding HistoryRows}" SelectedItem="{Binding SelectedHistory}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{DynamicResource Text42}" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="{DynamicResource Text43}" Binding="{Binding CreatedLabel}" Width="150"/>
              <DataGridTextColumn Header="{DynamicResource Text44}" Binding="{Binding Status}" Width="190"/>
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="{DynamicResource Text45}" Command="{Binding CopyHistoryCommand}"/>
            <Button Content="{DynamicResource Text46}" Command="{Binding OpenHistoryCommand}"/>
            <Button Content="{DynamicResource Text47}" Command="{Binding RevokeHistoryCommand}"/>
          </WrapPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Padding="0,16,0,0"><TextBlock Text="{Binding Notice}" AutomationProperties.LiveSetting="Polite"/></Border>
  </Grid>
</Window>
